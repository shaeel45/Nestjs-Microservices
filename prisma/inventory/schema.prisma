generator client {
  provider = "prisma-client"
  output   = "../../apps/inventory/src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["inventory_service"]
}

enum InventoryTransactionType {
  RESTOCK
  SALE
  RETURN
  DAMAGE
  ADJUSTMENT

  @@schema("inventory_service")
}

model InventoryItem {
  id                Int                       @id @default(autoincrement())
  productId         Int                       @unique
  /// On-hand quantity currently in warehouse
  quantity          Int                       @default(0)
  /// Quantity reserved for pending checkouts/orders
  reservedQuantity  Int                       @default(0)
  warehouse         String                    @default("default")
  lowStockThreshold Int                       @default(10)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  transactions      InventoryTransaction[]

  @@index([warehouse])
  @@index([quantity])
  @@map("ecommerce_inventory")
  @@schema("inventory_service")
}

model InventoryTransaction {
  id              Int                      @id @default(autoincrement())
  inventoryItemId Int
  inventoryItem   InventoryItem            @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  type            InventoryTransactionType
  /// Signed delta applied to on-hand quantity (e.g. +10 restock, -2 sale/damage)
  changeAmount    Int
  quantityBefore  Int
  quantityAfter   Int

  performedBy     String?
  reason          String?
  referenceId     String?

  createdAt       DateTime                 @default(now())

  @@index([inventoryItemId, createdAt])
  @@index([type, createdAt])
  @@index([referenceId])
  @@map("ecommerce_inventory_transactions")
  @@schema("inventory_service")
}
