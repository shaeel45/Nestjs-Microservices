generator client {
  provider = "prisma-client"
  output   = "../../apps/orders/src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique
  status      OrderStatus @default(PROCESSING)

  customerId    String?
  customerName  String
  customerEmail String
  customerPhone String?

  shippingFullName   String
  shippingStreet     String
  shippingCity       String
  shippingState      String
  shippingPostalCode String
  shippingCountry    String

  shippingMethod String @default("Standard Shipping")
  paymentMethod  String @default("Credit Card")
  promoCode      String?
  trackingNumber String?
  notes          String?

  subtotal    Float
  discount    Float @default(0)
  tax         Float @default(0)
  shippingFee Float @default(0)
  total       Float

  deliveredAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items  OrderItem[]
  events OrderStatusEvent[]

  @@index([status])
  @@index([customerId])
  @@index([customerEmail])
  @@index([createdAt])
  @@map("ecommerce_orders")
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   String?
  productName String
  unitPrice   Float
  quantity    Int
  size        String?
  color       String?
  image       String?
  lineTotal   Float

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("ecommerce_order_items")
}

model OrderStatusEvent {
  id          Int          @id @default(autoincrement())
  orderId     Int
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  performedBy String?
  createdAt   DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("ecommerce_order_status_events")
}

/**
 * Server-side shopping cart. Identified by a client-generated token so a guest
 * cart survives reloads, and linked to the storefront customer when known.
 */
model Cart {
  id            Int      @id @default(autoincrement())
  cartToken     String   @unique
  customerId    String?
  customerEmail String?

  /// Applied promo code snapshot; re-validated when checkout runs.
  promoCode       String?
  promoPercent    Float?
  promoValidUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]

  @@index([customerId])
  @@index([updatedAt])
  @@map("ecommerce_carts")
}

model CartItem {
  id        Int    @id @default(autoincrement())
  cartId    Int
  productId String?
  name      String
  price     Float
  quantity  Int
  size      String?
  color     String?
  image     String?
  lineTotal Float

  /// Normalised product+variant key so the same product/size/color is one line.
  variantKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantKey])
  @@index([cartId])
  @@index([productId])
  @@map("ecommerce_cart_items")
}
