generator client {
  provider = "prisma-client"
  output   = "../../apps/auth/src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model Credential {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  passwordHash String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RefreshToken {
  id                  String    @id @default(cuid())
  userId              Int
  familyId            String
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}