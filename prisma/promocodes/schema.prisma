generator client {
  provider = "prisma-client"
  output   = "../../apps/promocodes/src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["promocodes_service"]
}

model PromoCode {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  discountPercent Int
  description     String   @default("")
  active          Boolean  @default(true)
  usageCount      Int      @default(0)
  maxUses         Int?
  minOrderAmount  Float    @default(0)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  redemptions PromoCodeRedemption[]

  @@index([active])
  @@index([expiresAt])
  @@map("ecommerce_promo_codes")
  @@schema("promocodes_service")
}

model PromoCodeRedemption {
  id             Int      @id @default(autoincrement())
  promoCodeId    Int
  code           String
  orderReference String?
  orderAmount    Float
  discountAmount Float
  performedBy    String?
  createdAt      DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@index([promoCodeId, createdAt])
  @@index([orderReference])
  @@map("ecommerce_promo_code_redemptions")
  @@schema("promocodes_service")
}

/// Single-row store configuration: promotions banner, shipping rules and
/// branding. The `id` is pinned to 1 so reads and writes always target the
/// same record.
model StoreSetting {
  id                    Int      @id @default(1)
  storeName             String   @default("ShopForge")
  tagline               String   @default("Modern Wardrobe Essentials")
  supportEmail          String   @default("support@shopforge.com")
  bannerText            String   @default("")
  bannerActive          Boolean  @default(true)
  freeShippingEnabled   Boolean  @default(true)
  freeShippingThreshold Float    @default(75)
  standardShippingRate  Float    @default(9.99)
  expressShippingRate   Float    @default(14.99)
  handlingDays          Int      @default(1)
  currency              String   @default("USD")
  updatedAt             DateTime @updatedAt

  @@map("ecommerce_store_settings")
  @@schema("promocodes_service")
}
