
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int  @id @default(autoincrement())
  name  String
  email String  @unique
  user String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


