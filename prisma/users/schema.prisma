generator client {
  provider = "prisma-client"
  output   = "../../apps/users/src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["users_service"]
}

enum Role {
  CUSTOMER
  ADMIN

  @@schema("users_service")
}

model User {
  id        Int      @id @default(autoincrement())
  fullname  String   @default("")
  lastname  String   @default("")
  email     String   @unique
  role      Role     @default(CUSTOMER)

  // Default shipping address (edited from the storefront profile page).
  addressStreet     String @default("")
  addressCity       String @default("")
  addressState      String @default("")
  addressPostalCode String @default("")
  addressCountry    String @default("United States")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ecommerce_users")
  @@schema("users_service")
}